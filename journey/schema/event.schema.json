{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Journey event log line (one JSON object per line in .jsonl logs)",
  "type": "object",
  "required": [
    "type",
    "ts",
    "session_id",
    "topic"
  ],
  "properties": {
    "type": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "session.started"
        },
        "payload": {
          "type": "object",
          "properties": {
            "objective": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "session.completed"
        },
        "payload": {
          "type": "object",
          "properties": {
            "next_review": {
              "type": "string",
              "format": "date"
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "claim.submitted"
        },
        "payload": {
          "type": "object",
          "required": [
            "claim"
          ],
          "properties": {
            "claim": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "claim.verdict"
        },
        "payload": {
          "type": "object",
          "required": [
            "verdict",
            "tier",
            "record"
          ],
          "properties": {
            "verdict": {
              "type": "string",
              "enum": [
                "correct",
                "partial",
                "incorrect"
              ]
            },
            "tier": {
              "type": "string",
              "enum": [
                "T0",
                "T1",
                "T2",
                "T3",
                "T4"
              ]
            },
            "record": {
              "type": "string",
              "pattern": "^S-\\d+$"
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "quiz.attempted"
        },
        "payload": {
          "type": "object",
          "required": [
            "bank",
            "score",
            "bloom_scores"
          ],
          "properties": {
            "bank": {
              "type": "string",
              "enum": [
                "formative",
                "summative",
                "review"
              ]
            },
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "bloom_scores": {
              "type": "object"
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "review.due"
        },
        "payload": {
          "type": "object",
          "properties": {
            "due": {
              "type": "string",
              "format": "date"
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "review.completed"
        },
        "payload": {
          "type": "object",
          "properties": {
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "elaboration.submitted"
        },
        "payload": {
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "project.submitted"
        },
        "payload": {
          "type": "object",
          "properties": {
            "artifact": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "project.reviewed"
        },
        "payload": {
          "type": "object",
          "required": [
            "verdict",
            "rubric"
          ],
          "properties": {
            "verdict": {
              "type": "string",
              "enum": [
                "pass",
                "partial",
                "fail"
              ]
            },
            "rubric": {
              "type": "string"
            },
            "scores": {
              "type": "object"
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "matrix.updated"
        },
        "payload": {
          "type": "object",
          "required": [
            "level",
            "score",
            "validated"
          ],
          "properties": {
            "level": {
              "type": "string",
              "enum": [
                "novice",
                "advanced-beginner",
                "competent",
                "proficient",
                "expert"
              ]
            },
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "validated": {
              "type": "boolean"
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "calibration.updated"
        },
        "payload": {
          "type": "object",
          "required": [
            "predicted",
            "actual"
          ],
          "properties": {
            "predicted": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "actual": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "reflection.logged"
        },
        "payload": {
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
