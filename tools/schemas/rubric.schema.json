{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Strata project-review rubric",
  "type": "object",
  "required": ["id", "track", "standards-refs", "criteria"],
  "properties": {
    "id": {"type": "string", "minLength": 3},
    "track": {"type": "string"},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "standards-refs": {"type": "array", "items": {"type": "string"}},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description", "max_score"],
        "properties": {
          "name": {"type": "string"},
          "description": {"type": "string"},
          "max_score": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
